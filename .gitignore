# Binaries built at repo root (not the shipped dist/ package)
/implcache-mcp
/implcache-mcp.exe
/implcache-mcp.exe~
/ingestcli
/ingestcli.exe
*.exe
!/dist/*.exe

# End-user package: track binaries, VERSION, and empty starter DB.
# Ignore only local runtime junk created while testing the package.
/dist/*.db-wal
/dist/*.db-shm
/dist/vomit-output/
/dist/uploads/
/dist/.implcache/
/dist-linux-amd64/*.db-wal
/dist-linux-amd64/*.db-shm
/dist-linux-amd64/vomit-output/
/dist-linux-amd64/uploads/
/dist-linux-amd64/.implcache/
/dist-jetson-orin-nx/*.db-wal
/dist-jetson-orin-nx/*.db-shm
/dist-jetson-orin-nx/vomit-output/
/dist-jetson-orin-nx/uploads/
/dist-jetson-orin-nx/.implcache/

# Local knowledge databases (never publish ingested corpora)
*.db
!/dist/implcache.db
!/dist-linux-amd64/implcache.db
!/dist-jetson-orin-nx/implcache.db
*.db-wal
*.db-shm
implcache.db*
!/dist/implcache.db
!/dist-linux-amd64/implcache.db
!/dist-jetson-orin-nx/implcache.db
testdata/validation/reports/validation.db*

# Managed Git clone cache (beside the DB; recreated by ingest/refresh)
.implcache/

# Librarian upload staging (default: <db-dir>/uploads)
/uploads/

# Generated playbooks (default -output-root)
/vomit-output/
/*.md.bak
/REVIEW.local.md

# Frontend toolchain (optional Vite SPA source)
/frontend/node_modules/
/frontend/dist/

# Go / editor
.idea/
.vscode/
.cursor/
*.swp
*.tmp
tmp_*.go

# Local scratch / temp scaffolds (never publish)
/_scratch/
/_Scratch/

